QTabWidget::pane {
    border: 0;
    background: transparent;
}

QFrame#brain_panel { background-color: #090909;
    border-radius: 10px;
}

QPlainTextEdit#ai_log { background-color: #090909;
    color: #ffaa00;
    font-family: "Fixedsys";
    border-color: rgba(255, 255, 255, 0);
}

QFrame#main_log_panel { background-color: #090909;
    font-family: "Arial";
    font-size: 18px;
    font-weight: normal;
    border-radius: 10px;
}

QPlainTextEdit#main_log_text { background-color: #090909;
    color: #00ff7f;
    font-family: "Fixedsys";
    border-color: rgba(255, 255, 255, 0);
}

QFrame#top_artists_panel { background-color: #090909;
    border-radius: 10px;
}

QListWidget#top_list { background-color: #090909;
    color: #ffaa00;
    font-family: "Fixedsys";
    border-color: rgba(255, 255, 255, 0);
}

QFrame#history_panel { background-color: #090909;
    border-radius: 10px;
}

QListWidget#history_list { background-color: #090909;
    color: #00ff7f;
    font-family: "Fixedsys";
    border-color: rgba(255, 255, 255, 0);
}

QFrame#queue_panel { background-color: #090909;
    border-radius: 10px;
}

QListWidget#queue_list { background-color: #090909;
    color: #00ff7f;
    font-family: "Fixedsys";
    border-color: rgba(255, 255, 255, 0);
}

QLabel#track_title { font-family: "Consolas";
    font-size: 24px;
    font-weight: bold;
}

QFrame#search_panel { background-color: #050505;
    border-color: #050505;
    border-radius: 10px;
}

QSlider::groove:horizontal {
    height: 7px;
    background-color: #303036;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    border-radius: 3px;
    background-color: #ff1a1a;
}

QSlider::handle:horizontal {
    width: 13px;
    height: 13px;
    margin: -3px 0;
    background-color: #ff1a1a;
    border-radius: 6px;
}

QLabel#quickSettingLabel { color: #ffffff;
    font-weight: bold;
}

QFrame#quick_panel { border-radius: 10px;
    background-color: rgba(255, 255, 255, 16);
    border-width: 1px;
    border-style: solid;
    border-color: rgba(255, 255, 255, 64);
}

QCheckBox::indicator { background-color: rgba(30, 30, 30, 0);
    border-color: #7e7e7e;
    border-radius: 5px;
    width: 16px;
    height: 16px;
    border-style: solid;
    border-width: 1px;
}

QFrame#scout_strip { background-color: #121612;
    font-family: "Arial";
    font-weight: bold;
    border-radius: 6px;
}

QWidget[spyderThemeId="scout_primary"] { color: #00ff7f;
    font-family: "Fixedsys";
}

QWidget[spyderThemeId="scout_secondary"] { color: #b3eec2;
    font-family: "Fixedsys";
}

QWidget[spyderThemeId="negative_rating"] { background-color: #ff1a1a; }

QWidget[spyderThemeId="positive_rating"] { background-color: #005500; }

QWidget[spyderThemeId="rating_score"] { background-color: rgba(4, 4, 4, 0);
    color: #ffff00;
    font-family: "Fixedsys";
    font-weight: normal;
}

QTabBar::tab { font-weight: normal; }

QCheckBox { background-color: rgba(4, 4, 4, 0);
    border-color: #7e7e7e;
}

QCheckBox::indicator:checked { background-color: #ff1a1a;
    width: 16px;
    height: 16px;
    border-color: #7e7e7e;
    border-style: solid;
    border-width: 1px;
    border-radius: 5px;
}

QCheckBox::indicator:disabled { background-color: rgba(30, 30, 30, 0);
    width: 16px;
    height: 16px;
    border-color: #7e7e7e;
    border-style: solid;
    border-width: 1px;
    border-radius: 5px;
}

QSlider[spyderThemeId="temperature"]::groove:horizontal {
    height: 7px;
    background-color: #2e2e34;
    border-radius: 3px;
    background-color: #303036;
    background: #444444;
}

QSlider[spyderThemeId="temperature"]::sub-page:horizontal {
    border-radius: 3px;
    background-color: #ff1a1a;
}

QSlider[spyderThemeId="temperature"]::handle:horizontal {
    width: 13px;
    height: 13px;
    margin: -3px 0;
    
    border-radius: 6px;
    background-color: #fe1a1a;
}

/* >>> SPYDERMUSIC SNOW-ICE TAB-GEOMETRIE (AUTO) >>> */
/* Shape and default alignment only. Do not override colors. */
QTabWidget::tab-bar {
    alignment: center;
}
QTabBar::tab {
    padding: 6px 14px;
    margin: 4px 2px;
    border: 0;
    border-radius: 10px;
    font-weight: bold;
    background-color: rgba(255, 255, 255, 32);
}
/* <<< SPYDERMUSIC SNOW-ICE TAB-GEOMETRIE (AUTO) <<< */

QTabBar::tab:hover { background-color: rgba(255, 255, 255, 64); }

QTabBar::tab:selected { background-color: rgba(255, 255, 255, 64); }

QMainWindow#peq_panel { background-color: #090909;
    color: rgba(9, 9, 9, 0);
    border-color: #090909;
    border-style: solid;
    border-width: 1px;
    border-radius: 10px;
}

QDoubleSpinBox { background-color: #ff0000; }

QWidget#peq_plot { background-color: #090909;
    border-color: #ffff00;
    border-style: solid;
    border-width: 1px;
    color: #00ff7f;
    qproperty-peqBackground: #080808;
    qproperty-peqGrid: #00ff7f;
    qproperty-peqAxis: #00ff7f;
    qproperty-peqSum: #00ff7f;
    qproperty-peqBand1: #5555ff;
    qproperty-peqBand2: #55ffff;
    qproperty-peqBand3: #55ff55;
    qproperty-peqBand4: #ffff55;
    qproperty-peqBand5: #ff5555;
    qproperty-peqBand6: #0000aa;
    qproperty-peqBand7: #00aaaa;
    qproperty-peqBand8: #00aa00;
    qproperty-peqBand9: #aa5500;
    qproperty-peqBand10: #aa0000;
}
